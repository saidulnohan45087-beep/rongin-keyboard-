                  return if (v < 0) globalOpens(c) else v
              }

              fun setOpenLimit(c: Context, pkg: String, v: Int) { sp(c).edit().putInt("olim_$pkg", v).apply() }

              fun opens(c: Context, pkg: String): Int = sp(c).getInt("o_${day()}_$pkg", 0)

              fun addOpen(c: Context, pkg: String) {
                  sp(c).edit().putInt("o_${day()}_$pkg", opens(c, pkg) + 1).apply()
              }

