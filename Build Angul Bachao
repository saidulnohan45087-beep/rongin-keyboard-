          cat > angul-app/app/src/main/java/com/angulbachao/app/GuardService.kt <<'ANGUL_EOF'
          package com.angulbachao.app

          import android.accessibilityservice.AccessibilityService
          import android.content.Context
          import android.graphics.Color
          import android.graphics.PixelFormat
          import android.graphics.Typeface
          import android.graphics.drawable.GradientDrawable
          import android.os.Handler
          import android.os.Looper
          import android.os.PowerManager
          import android.os.VibrationEffect
          import android.os.Vibrator
          import android.view.Gravity
          import android.view.View
          import android.view.WindowManager
          import android.view.accessibility.AccessibilityEvent
          import android.view.inputmethod.InputMethodManager
          import android.widget.TextView
          import kotlin.math.ceil
          import kotlin.math.max

          /**
           * কোন অ্যাপ খোলা আছে তা ধরে, সময় গোনে, সীমা পেরোলে স্ক্রিনের ওপর আঙুল-কাটা অ্যানিমেশন দেখায়
           * এবং হোম স্ক্রিনে পাঠিয়ে দেয়। শুধু অ্যাক্সেসিবিলিটি পারমিশনই লাগে।
           */
          class GuardService : AccessibilityService() {

              private val handler = Handler(Looper.getMainLooper())
              private lateinit var wm: WindowManager
              private var current: String? = null
              private var cutView: View? = null
              private var warnView: View? = null
              private var lastCutAt = 0L
              private val warned = HashSet<String>()

              private val ticker = object : Runnable {
                  override fun run() {
                      try {
                          onTick()
                      } catch (e: Exception) {
                          // সেবা যেন বন্ধ না হয়
                      }
                      handler.postDelayed(this, 1000)
                  }
              }

              override fun onServiceConnected() {
                  super.onServiceConnected()
                  wm = getSystemService(Context.WINDOW_SERVICE) as WindowManager
                  handler.removeCallbacks(ticker)
                  handler.post(ticker)
              }

              override fun onAccessibilityEvent(e: AccessibilityEvent?) {
                  if (e == null || e.eventType != AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED) return
                  val pkg = e.packageName?.toString() ?: return
                  // নিজের ওভারলের ইভেন্ট ধরব না
                  if (pkg == packageName && (cutView != null || warnView != null)) return
                  if (pkg == "com.android.systemui" || pkg in imePackages()) return
                  val isNew = pkg != current
                  current = pkg
                  if (!Prefs.isMonitored(this, pkg) || Prefs.isPaused(this)) return
                  if (isNew) {
                      // নতুন করে ঢোকা: দিনের ঢোকার সীমা পেরোলে সাথে সাথে কাটা
                      if (Prefs.opens(this, pkg) >= Prefs.openLimit(this, pkg)) {
                          if (cutView == null && System.currentTimeMillis() - lastCutAt >= 5000) cut()
                          return
                      }
                      Prefs.addOpen(this, pkg)
                  }
                  // সময় শেষ হলে আইকনে ক্লিক করে ঢুকলেও আবার কাটা
                  if (shouldBlock(pkg)) cut()
              }

              override fun onInterrupt() {}

              override fun onDestroy() {
                  handler.removeCallbacksAndMessages(null)
                  removeCut()
                  hideWarn()
                  super.onDestroy()
              }

              // ---------- যুক্তি ----------

              private fun imePackages(): Set<String> = try {
                  (getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager)
                      .enabledInputMethodList.map { it.packageName }.toSet()
              } catch (e: Exception) {
                  emptySet()
              }

              private fun overLimit(pkg: String): Boolean {
                  if (Prefs.inNight(this)) return true
                  val lim = Prefs.limitMin(this, pkg) * 60
                  val tl = Prefs.totalLimit(this) * 60
                  return Prefs.used(this, pkg) >= lim || Prefs.totalSec(this, Prefs.day()) >= tl
              }

              private fun shouldBlock(pkg: String): Boolean {
                  if (cutView != null) return false
                  if (!Prefs.isMonitored(this, pkg)) return false
                  if (Prefs.isPaused(this)) return false
                  if (System.currentTimeMillis() - lastCutAt < 5000) return false
                  return overLimit(pkg)
              }

              private fun onTick() {
                  val pkg = current ?: return
                  if (cutView != null) return
                  val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
                  if (!pm.isInteractive) return
                  if (!Prefs.isMonitored(this, pkg) || Prefs.isPaused(this)) return
                  if (System.currentTimeMillis() - lastCutAt < 5000) return

                  if (overLimit(pkg)) {
                      cut()
                      return
                  }
                  Prefs.addUsage(this, pkg, 1)

                  val lim = Prefs.limitMin(this, pkg) * 60
                  val tl = Prefs.totalLimit(this) * 60
                  val usedP = Prefs.used(this, pkg)
                  val usedT = Prefs.totalSec(this, Prefs.day())
                  val hot = usedP >= lim * 0.8 || usedT >= tl * 0.8
                  if (hot && warned.add(Prefs.day() + pkg)) {
                      val remain = minOf(lim - usedP, tl - usedT)
                      showWarn(ceil(remain / 60.0).toInt())
                  }
              }

              // ---------- আঙুল কাটা ----------

              private fun cut() {
                  if (cutView != null) return
                  lastCutAt = System.currentTimeMillis()
                  hideWarn()
                  val n = Prefs.addCut(this)
                  val left = Prefs.MAX_FINGERS - n
                  val v = CutView(this, left)
                  val lp = WindowManager.LayoutParams(
                      WindowManager.LayoutParams.MATCH_PARENT,
                      WindowManager.LayoutParams.MATCH_PARENT,
                      WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
