                  sp(c).edit().putLong("paused_until", System.currentTimeMillis() + minutes * 60_000L).apply()
              }

              fun pausedLeftMin(c: Context): Int {
                  val left = sp(c).getLong("paused_until", 0L) - System.currentTimeMillis()
