          package com.angulbachao.app

          import android.content.Context
          import android.graphics.Canvas
          import android.graphics.DashPathEffect
          import android.graphics.Paint
          import android.graphics.RectF
          import android.view.View
          import kotlin.math.max

          /** শেষ ৭ দিনের সোশ্যাল মিডিয়া সময় (মিনিট)। লাল = ঐদিন আঙুল কাটা গেছে, সবুজ = নিরাপদ */
          class BarChartView(ctx: Context) : View(ctx) {

              private var mins = IntArray(7)
              private var cuts = IntArray(7)
              private var labels: List<String> = List(7) { "" }
              private var limit = 120
              private val p = Paint(Paint.ANTI_ALIAS_FLAG)

              fun setData(m: IntArray, c: IntArray, l: List<String>, lim: Int) {
                  mins = m
                  cuts = c
                  labels = l
                  limit = lim
                  invalidate()
              }

              override fun onDraw(c: Canvas) {
                  val w = width.toFloat()
                  val h = height.toFloat()
                  val d = resources.displayMetrics.density
                  val top = 16f * d
                  val bottom = h - 22f * d
                  val maxV = max(limit, mins.maxOrNull() ?: 0).coerceAtLeast(1)
                  val slot = w / 7f
                  val bw = slot * 0.5f

                  for (i in 0 until 7) {
                      val bh = (mins[i].toFloat() / maxV) * (bottom - top)
                      val x = i * slot + (slot - bw) / 2f
                      p.style = Paint.Style.FILL
                      p.color = if (cuts[i] > 0) 0xFFD32F2F.toInt() else 0xFF43A047.toInt()
                      c.drawRoundRect(RectF(x, bottom - bh, x + bw, bottom), 6f * d, 6f * d, p)
                      p.color = 0xFFB0BEC5.toInt()
                      p.textSize = 11f * d
                      p.textAlign = Paint.Align.CENTER
                      c.drawText(labels[i], x + bw / 2f, h - 6f * d, p)
                      if (mins[i] > 0) {
                          c.drawText(bn(mins[i]), x + bw / 2f, bottom - bh - 4f * d, p)
                      }
                  }

                  val ly = bottom - limit.toFloat() / maxV * (bottom - top)
                  p.style = Paint.Style.STROKE
                  p.color = 0x88FFFFFF.toInt()
                  p.strokeWidth = 1.5f * d
                  p.pathEffect = DashPathEffect(floatArrayOf(10f * d, 8f * d), 0f)
                  c.drawLine(0f, ly, w, ly, p)
                  p.pathEffect = null
              }
          }
