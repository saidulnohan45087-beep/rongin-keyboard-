              fun nightOn(c: Context): Boolean = sp(c).getBoolean("night_on", false)
              fun nightStart(c: Context): Int = sp(c).getInt("night_start", 0)
              fun nightEnd(c: Context): Int = sp(c).getInt("night_end", 6)

              fun setNight(c: Context, on: Boolean, start: Int, end: Int) {
                  sp(c).edit().putBoolean("night_on", on).putInt("night_start", start).putInt("night_end", end).apply()
              }

              fun inNight(c: Context): Boolean {
                  if (!nightOn(c)) return false
                  val h = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
                  val s = nightStart(c)
                  val e = nightEnd(c)
                  return if (s < e) h in s until e else (h >= s || h < e)
              }

