          package com.angulbachao.app

          import android.content.Context
          import java.text.SimpleDateFormat
          import java.util.Calendar
          import java.util.Locale

          object Prefs {
              const val MAX_FINGERS = 10

              private fun sp(c: Context) = c.getSharedPreferences("angul", Context.MODE_PRIVATE)

              // ---------- তারিখ ----------
              fun day(offset: Int = 0): String {
                  val cal = Calendar.getInstance()
                  cal.add(Calendar.DAY_OF_YEAR, offset)
                  return SimpleDateFormat("yyyyMMdd", Locale.US).format(cal.time)
              }

              fun dayLabel(offset: Int): String {
                  val cal = Calendar.getInstance()
                  cal.add(Calendar.DAY_OF_YEAR, offset)
                  return bn(cal.get(Calendar.DAY_OF_MONTH))
              }

              fun firstDay(c: Context): String {
                  val s = sp(c)
                  val d = s.getString("first_day", null)
                  if (d != null) return d
                  val t = day()
                  s.edit().putString("first_day", t).apply()
                  return t
              }

              // ---------- ফিল্টার: সবুজ টিক / লাল টিক ----------
              fun isMonitored(c: Context, pkg: String): Boolean =
                  sp(c).getBoolean("mon_$pkg", pkg in SocialApps.known)

              fun setMonitored(c: Context, pkg: String, on: Boolean) {
                  sp(c).edit().putBoolean("mon_$pkg", on).apply()
              }

              // ---------- সীমা ----------
              fun globalLimit(c: Context): Int = sp(c).getInt("global_limit", 30)
              fun setGlobalLimit(c: Context, v: Int) { sp(c).edit().putInt("global_limit", v).apply() }

              fun totalLimit(c: Context): Int = sp(c).getInt("total_limit", 120)
              fun setTotalLimit(c: Context, v: Int) { sp(c).edit().putInt("total_limit", v).apply() }

              fun limitMin(c: Context, pkg: String): Int {
                  val v = sp(c).getInt("lim_$pkg", -1)
                  return if (v < 0) globalLimit(c) else v
              }

              fun setLimit(c: Context, pkg: String, v: Int) { sp(c).edit().putInt("lim_$pkg", v).apply() }

