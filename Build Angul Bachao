          package com.angulbachao.app

          import android.animation.ValueAnimator
          import android.content.Context
          import android.graphics.Canvas
          import android.graphics.Color
          import android.graphics.LinearGradient
          import android.graphics.Paint
          import android.graphics.Path
          import android.graphics.Shader
          import android.graphics.Typeface
          import android.view.MotionEvent
          import android.view.View
          import android.view.animation.LinearInterpolator
          import kotlin.math.cos
          import kotlin.math.hypot
          import kotlin.math.max
          import kotlin.math.min
          import kotlin.math.sin
          import kotlin.random.Random

          /** ব্লেড পড়ে → আঙুল কাটে → রক্তে স্ক্রিন ভরে যায় (পুরোটাই কার্টুন অ্যানিমেশন) */
          class CutView(ctx: Context, private val left: Int) : View(ctx) {

              private var t = 0f
              private val tHit = 1.0f
              private val rnd = Random(7)

              private val drops = List(70) {
                  Triple(rnd.nextFloat() * 6.28f, 250f + rnd.nextFloat() * 900f, 6f + rnd.nextFloat() * 16f)
              }
              private val dripX = List(14) { rnd.nextFloat() }
              private val dripLen = List(14) { 0.12f + rnd.nextFloat() * 0.38f }

              private val p = Paint(Paint.ANTI_ALIAS_FLAG)
              private val path = Path()

              private val anim = ValueAnimator.ofFloat(0f, 4.2f).apply {
                  duration = 4200
                  interpolator = LinearInterpolator()
                  addUpdateListener {
                      t = it.animatedValue as Float
                      invalidate()
                  }
              }

              fun start() {
                  anim.start()
              }

              override fun onDetachedFromWindow() {
                  anim.cancel()
                  super.onDetachedFromWindow()
              }

              // অ্যানিমেশন চলার সময় নিচের অ্যাপে কোনো টাচ যাবে না
              override fun onTouchEvent(event: MotionEvent?): Boolean = true

              override fun onDraw(c: Canvas) {
                  val w = width.toFloat()
                  val h = height.toFloat()
                  val s = w / 1080f
                  val fw = 170f * s
                  val cx = w * 0.66f            // বুড়ো আঙুলের জায়গা (ডান হাতের থাম্ব-জোন)
                  val tipY0 = h * 0.60f
                  val cutY = tipY0 + fw * 1.15f
                  val bw = 420f * s
                  val bh = 520f * s

                  // আবছা কালো পর্দা
                  c.drawColor(Color.argb((min(t / 0.5f, 1f) * 150).toInt(), 0, 0, 0))

                  c.save()
                  // আঘাতের ঝাঁকুনি
                  if (t > tHit && t < tHit + 0.35f) {
                      val k = (1f - (t - tHit) / 0.35f) * 22f * s
                      c.translate((Random.nextFloat() - 0.5f) * k, (Random.nextFloat() - 0.5f) * k)
                  }

                  val tipY = lerp(h, tipY0, ease(seg(t, 0f, 0.5f)))

                  if (t < tHit) {
                      Draw.finger(c, cx, tipY, fw, h)
                  } else {
                      // নিচের অংশ (গোড়া)
                      c.save()
                      c.clipRect(0f, cutY, w, h)
                      Draw.finger(c, cx, tipY, fw, h)
                      c.restore()
                      p.style = Paint.Style.FILL
                      p.color = 0xFFB00012.toInt()
                      c.drawRect(cx - fw / 2, cutY, cx + fw / 2, cutY + 16f * s, p)

                      // কাটা ডগা — উড়ে যায়
                      val tt = t - tHit
                      c.save()
                      c.translate(340f * s * tt, (-650f * tt + 1400f * tt * tt) * s)
                      c.rotate(260f * tt, cx, cutY)
                      c.clipRect(0f, 0f, w, cutY)
                      Draw.finger(c, cx, tipY, fw, h)
                      p.style = Paint.Style.FILL
                      p.color = 0xFFB00012.toInt()
                      c.drawRect(cx - fw / 2, cutY - 16f * s, cx + fw / 2, cutY, p)
                      c.restore()
                  }

                  // ব্লেড
                  val yB: Float = when {
                      t < tHit -> lerp(-bh, cutY, (t / tHit) * (t / tHit))
                      t < tHit + 0.8f -> cutY
                      else -> cutY - bh * ease(seg(t, tHit + 0.8f, tHit + 1.5f))
                  }
                  p.style = Paint.Style.STROKE
                  p.strokeWidth = 8f * s
                  p.color = 0xFF6D4C41.toInt()
                  c.drawLine(cx, 0f, cx, yB - bh, p)

                  path.reset()
                  path.moveTo(cx - bw / 2, yB - bh)
                  path.lineTo(cx + bw / 2, yB - bh)
                  path.lineTo(cx + bw / 2, yB - 28f * s)
                  path.lineTo(cx - bw / 2, yB + 28f * s)
                  path.close()
                  p.style = Paint.Style.FILL
                  p.shader = LinearGradient(
                      cx - bw / 2, 0f, cx + bw / 2, 0f,
                      intArrayOf(0xFF8E9AA3.toInt(), 0xFFEEF3F6.toInt(), 0xFF6F7B84.toInt()),
                      floatArrayOf(0f, 0.5f, 1f), Shader.TileMode.CLAMP
                  )
                  c.drawPath(path, p)
                  p.shader = null
                  p.style = Paint.Style.STROKE
                  p.strokeWidth = 5f * s
                  p.color = if (t >= tHit) 0xFFD50000.toInt() else Color.WHITE
                  c.drawLine(cx - bw / 2, yB + 28f * s, cx + bw / 2, yB - 28f * s, p)

                  // রক্তের ছিটা
                  if (t > tHit && t < tHit + 1.6f) {
                      val tt = t - tHit
                      p.style = Paint.Style.FILL
                      p.color = 0xFFC0101C.toInt()
                      for ((a, sp, r) in drops) {
                          val x = cx + cos(a) * sp * tt * s
                          val y = cutY + sin(a) * sp * tt * s + 900f * tt * tt * s
                          c.drawCircle(x, y, max(0f, r * s * (1f - tt / 1.8f)), p)
                      }
                  }
                  c.restore()

                  // পুরো স্ক্রিন রক্তে ভরে যাওয়া
                  if (t > tHit + 0.1f) {
                      val k = ease(seg(t, tHit + 0.1f, tHit + 1.6f))
                      val maxR = hypot(max(cx, w - cx), max(cutY, h - cutY))
                      p.style = Paint.Style.FILL
                      p.color = 0xF2B3000C.toInt()
                      c.drawCircle(cx, cutY, maxR * 1.05f * k, p)
                  }

                  // রক্তের ফোঁটা গড়িয়ে পড়া
                  if (t > tHit + 1.0f) {
                      val k = ease(seg(t, tHit + 1.0f, tHit + 2.2f))
                      p.color = 0xFF7A0008.toInt()
                      p.strokeCap = Paint.Cap.ROUND
                      p.strokeWidth = 26f * s
                      for (i in dripX.indices) {
                          val x = dripX[i] * w
                          val len = dripLen[i] * h * k
                          p.style = Paint.Style.STROKE
                          c.drawLine(x, 0f, x, len, p)
                          p.style = Paint.Style.FILL
                          c.drawCircle(x, len, 20f * s, p)
                      }
                      p.strokeCap = Paint.Cap.BUTT
                  }

                  // লেখা
                  if (t > 1.5f) {
                      val a = min((t - 1.5f) / 0.5f, 1f)
                      p.style = Paint.Style.FILL
                      p.textAlign = Paint.Align.CENTER
                      p.typeface = Typeface.DEFAULT_BOLD
                      p.color = Color.WHITE
                      p.alpha = (a * 255).toInt()
                      p.textSize = 110f * s
                      c.drawText("আঙুল গেল!", w / 2, h * 0.34f, p)
                      p.textSize = 56f * s
                      val msg = if (left > 0) "আর ${bn(left)}টি আঙুল বাকি" else "আজ আর কোনো আঙুল নেই!"
                      c.drawText(msg, w / 2, h * 0.34f + 90f * s, p)
                      p.alpha = 255
                      p.textAlign = Paint.Align.LEFT
                  }
              }
          }
          ANGUL_EOF
          mkdir -p angul-app/app/src/main/java/com/angulbachao/app
          cat > angul-app/app/src/main/java/com/angulbachao/app/Draw.kt <<'ANGUL_EOF'
          package com.angulbachao.app

          import android.graphics.Canvas
          import android.graphics.LinearGradient
          import android.graphics.Paint
          import android.graphics.Path
          import android.graphics.RectF
          import android.graphics.Shader

          /** CutView ও RewardView-এর সবার ব্যবহারের আঁকার সরঞ্জাম */
          object Draw {
              private val p = Paint(Paint.ANTI_ALIAS_FLAG)
              private val path = Path()

              /** কার্টুন আঙুল: ডগা ওপরে (tipY), নিচে bottom পর্যন্ত */
              fun finger(c: Canvas, cx: Float, tipY: Float, fw: Float, bottom: Float) {
                  val r = RectF(cx - fw / 2, tipY, cx + fw / 2, bottom + fw)
                  p.style = Paint.Style.FILL
                  p.shader = LinearGradient(
                      cx - fw / 2, 0f, cx + fw / 2, 0f,
                      intArrayOf(0xFFE8A97E.toInt(), 0xFFF9CFA8.toInt(), 0xFFEBB083.toInt()),
                      floatArrayOf(0f, 0.45f, 1f), Shader.TileMode.CLAMP
                  )
                  c.drawRoundRect(r, fw / 2, fw / 2, p)
                  p.shader = null

                  p.style = Paint.Style.STROKE
                  p.strokeWidth = fw * 0.03f
                  p.color = 0xFFB77A52.toInt()
                  c.drawRoundRect(r, fw / 2, fw / 2, p)

                  // নখ
                  val n = RectF(cx - fw * 0.3f, tipY + fw * 0.2f, cx + fw * 0.3f, tipY + fw * 0.8f)
                  p.style = Paint.Style.FILL
                  p.color = 0xFFFBE4D6.toInt()
                  c.drawRoundRect(n, fw * 0.25f, fw * 0.25f, p)
                  p.style = Paint.Style.STROKE
                  p.strokeWidth = fw * 0.02f
                  p.color = 0xFFE0B9A3.toInt()
                  c.drawRoundRect(n, fw * 0.25f, fw * 0.25f, p)

                  // গিঁটের দাগ
                  p.strokeWidth = fw * 0.025f
                  p.color = 0x88B77A52.toInt()
                  val y1 = tipY + fw * 1.7f
                  val y2 = tipY + fw * 2.7f
                  c.drawLine(cx - fw * 0.28f, y1, cx + fw * 0.28f, y1, p)
                  c.drawLine(cx - fw * 0.28f, y2, cx + fw * 0.28f, y2, p)
                  p.style = Paint.Style.FILL
              }

              fun heart(c: Canvas, x: Float, y: Float, s: Float, color: Int) {
                  path.reset()
                  path.moveTo(x, y + s * 0.4f)
                  path.cubicTo(x + s * 1.0f, y - s * 0.2f, x + s * 0.5f, y - s * 0.9f, x, y - s * 0.3f)
                  path.cubicTo(x - s * 0.5f, y - s * 0.9f, x - s * 1.0f, y - s * 0.2f, x, y + s * 0.4f)
                  p.style = Paint.Style.FILL
                  p.color = color
                  c.drawPath(path, p)
              }

              fun star(c: Canvas, x: Float, y: Float, s: Float, color: Int) {
                  path.reset()
                  path.moveTo(x, y - s)
                  path.quadTo(x, y, x + s, y)
                  path.quadTo(x, y, x, y + s)
                  path.quadTo(x, y, x - s, y)
                  path.quadTo(x, y, x, y - s)
                  p.style = Paint.Style.FILL
                  p.color = color
                  c.drawPath(path, p)
              }
          }
          ANGUL_EOF
